+def _unwrap_model(model):
+    unwrapped = model
+    seen = set()
+    while hasattr(unwrapped, 'module') and id(unwrapped) not in seen:
+        seen.add(id(unwrapped))
+        unwrapped = unwrapped.module
+    return unwrapped
