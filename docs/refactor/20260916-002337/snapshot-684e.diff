@@ -0,0 +1,64 @@
+"""仅验证资源准入与冻结参数；不调用真实 GPU 或训练进程。"""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+SCRIPT = Path(__file__).with_name('run_formal_population_tako.sh')
+
+
+class FormalWrapperTests(unittest.TestCase):
+    def invoke(self, sample, mode='run'):
+        with tempfile.TemporaryDirectory(prefix='population-wrapper-') as tmp:
+            root = Path(tmp)
+            (root / 'src').mkdir()
+            commands = root / 'bin'
+            commands.mkdir()
+            gpu = commands / 'nvidia-smi'
+            gpu.write_text('#!/bin/sh\nprintf "%s\\n" "$TEST_GPU_SAMPLE"\n')
+            gpu.chmod(0o755)
+            python = commands / 'python'
+            python.write_text('#!/bin/sh\nprintf "LAUNCH_ARG=%s\\n" "$@"\n')
+            python.chmod(0o755)
+            env = dict(os.environ, PATH=f'{commands}:{os.environ["PATH"]}',
+                       NPJ_POPULATION_ROOT=tmp, NPJ_POPULATION_PYTHON=str(python),
+                       TEST_GPU_SAMPLE=sample)
+            return subprocess.run(['bash', str(SCRIPT), '2', mode], env=env,
+                                  text=True, capture_output=True, timeout=10)
+
+    def test_shared_gpu_below_40_is_accepted(self):
+        result = self.invoke('6770, 34190, 39')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('LAUNCH_ARG=scripts/train_launcher.py', result.stdout)
+        for value in ('population', '8', 'BLCA,BRCA,LGG,LUAD,UCEC',
+                      '123,132,213,231,321', '100', '15', '32'):
+            self.assertIn(f'LAUNCH_ARG={value}\n', result.stdout)
+
+    def test_idle_gpu_is_accepted(self):
+        self.assertEqual(self.invoke('0, 40960, 0').returncode, 0)
+
+    def test_40_and_above_are_rejected(self):
+        for util in (40, 100):
+            with self.subTest(util=util):
+                result = self.invoke(f'6770, 34190, {util}')
+                self.assertEqual(result.returncode, 3)
+                self.assertNotIn('LAUNCH_ARG=', result.stdout)
+
+    def test_invalid_gpu_output_fails_closed(self):
+        for sample in ('', '0, 40960, N/A', '0, 40960, -1',
+                       '0, 40960, 101', '0, 40960, 1\n0, 40960, 1'):
+            with self.subTest(sample=sample):
+                result = self.invoke(sample)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertNotIn('LAUNCH_ARG=', result.stdout)
+
+    def test_dry_run_needs_no_gpu(self):
+        result = self.invoke('N/A', 'dry-run')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('LAUNCH_ARG=--dry_run', result.stdout)
+
+
+if __name__ == '__main__':
+    unittest.main()
