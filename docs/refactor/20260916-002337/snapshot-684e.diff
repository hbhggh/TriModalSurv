@@ -0,0 +1,150 @@
+"""只读统计生产 dataset 的训练集与完整病例；不训练、不聚类、不写 cache。
+
+远端执行示例（输出 JSON 到 stdout，dataset 日志到 stderr）：
+  python -B - --source SOURCE --assets ASSETS < count_complete_patients.py
+本次按训练入口缺省固定缺失设置统计；不声明尚未指定的正式缺失协议。
+"""
+import argparse
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--assets", type=Path, required=True)
+    args = parser.parse_args()
+    source, assets = args.source.resolve(), args.assets.resolve()
+    sys.path.insert(0, str(source))
+    import pandas as pd
+    import torch
+    from loc_utils_3yr.tcga_dataset import TCGASurDataset
+    from population_runtime import PopulationTrainView
+
+    torch.set_num_threads(1)
+    os.chdir(assets)
+    label = assets / "data/TCGA_9523_ex12.csv"
+    manifest = assets / "data/missing_manifest_v1.csv"
+    label_frame = pd.read_csv(label)
+    cancers = ["BLCA", "BRCA", "LGG", "LUAD", "UCEC"]
+    seeds = [123, 132, 213, 231, 321]
+    report = {
+        "scope": "read-only cached production dataset; no training or clustering",
+        "source": str(source), "assets": str(assets),
+        "label": {"path": str(label), "sha256": sha256(label)},
+        "manifest": {"path": str(manifest), "sha256": sha256(manifest),
+                     "used": False},
+        "dataset_sha256": sha256(source / "loc_utils_3yr/tcga_dataset.py"),
+        "population_runtime_sha256": sha256(source / "population_runtime.py"),
+        "settings": {"simulate_missing_modality": None, "missing_grid": None,
+                     "missing_manifest": None, "modality_dropout": 0.0,
+                     "img_select": "all", "n_image_tokens": 128},
+        "validity": "PopulationTrainView -> safe_modality_get return_mask; "
+                    "all three img/rna/text valid; not nonzero-feature criterion",
+        "seed_changes_split": False,
+        "seed_explanation": "TCGASurDataset filters the fixed CSV split; seed only "
+                            "initializes modality-dropout RNG, bypassed by bank view",
+        "caches": [], "rows": [],
+    }
+
+    class ReadOnlyDataset(TCGASurDataset):
+        def _load_cache(self):
+            # 必须全三侧命中指定缓存；不允许冷读或任何隐式重建。
+            super()._load_cache()
+            if set(self._loaded_cache_files) != {"img", "rna", "text"}:
+                raise RuntimeError("All three cached modalities are required")
+            missing_img = set(self.patient_id) - set(self.dict_data["img"])
+            if missing_img:
+                raise RuntimeError("Image cache does not cover label split")
+
+        def _save_cache(self):
+            pass
+
+    def existing_directory_only(path, *positional, **keywords):
+        if not path.is_dir():
+            raise RuntimeError(f"Would create directory: {path}")
+
+    modalities = {
+        # 此统计绑定部署的 cache-only 数据视图，raw fallback 不存在且不下载。
+        modality: SimpleNamespace(path=str(assets / "data" / raw))
+        for modality, raw in (("img", "tcga-dataset_uni2"),
+                              ("rna", "RNA_embedding_selfmade"),
+                              ("text", "text_embeddings_parsed"))
+    }
+    with contextlib.redirect_stdout(sys.stderr), patch.object(
+            Path, "mkdir", existing_directory_only):
+        for cancer in cancers:
+            reference = None
+            hashes = {}
+            for seed in seeds:
+                dataset = ReadOnlyDataset(
+                    label, modalities, "train", "surv", img_select="all",
+                    n_image_tokens=128, cancer_types=cancer, network_type="NPJC",
+                    simulate_missing_modality=None, missing_manifest=None,
+                    missing_grid=None, modality_dropout=0.0, seed=seed,
+                )
+                if len(set(dataset.selected_pids)) != len(dataset.selected_pids):
+                    raise RuntimeError("Duplicate real training patient IDs")
+                heldout = set(label_frame.loc[
+                    (label_frame.cancer_type == cancer) &
+                    (label_frame.split != "train"), "patient_id"])
+                if set(dataset.selected_pids) & heldout:
+                    raise RuntimeError("Train/heldout patient overlap")
+                view = PopulationTrainView(dataset)
+                complete = []
+                present = {modality: 0 for modality in modalities}
+                for index, patient in enumerate(dataset.selected_pids):
+                    sample = view[index]
+                    flags = {m: bool(sample[m + "_valid"]) for m in modalities}
+                    for modality, available in flags.items():
+                        present[modality] += int(available)
+                        if available and not torch.isfinite(sample[modality]).all():
+                            raise RuntimeError("Non-finite available feature")
+                    if all(flags.values()):
+                        complete.append(patient)
+                signature = (dataset.selected_pids, complete, present)
+                if reference is not None and reference != signature:
+                    raise RuntimeError("Unexpected seed-dependent count or membership")
+                reference = signature
+                report["rows"].append({
+                    "cancer": cancer, "seed": seed,
+                    "train_total": len(dataset), "complete_train": len(complete),
+                    "available": present,
+                    "train_patient_ids_sha256": hashlib.sha256(
+                        "\n".join(dataset.selected_pids).encode()).hexdigest(),
+                    "complete_patient_ids_sha256": hashlib.sha256(
+                        "\n".join(complete).encode()).hexdigest(),
+                })
+                if seed == seeds[0]:
+                    for modality, path in dataset._loaded_cache_files.items():
+                        path = path.resolve()
+                        hashes[str(path)] = sha256(path)
+                        report["caches"].append({
+                            "cancer": cancer, "modality": modality,
+                            "path": str(path), "sha256": hashes[str(path)],
+                            "bytes": path.stat().st_size,
+                        })
+                del view, dataset
+            for path, original in hashes.items():
+                if sha256(path) != original:
+                    raise RuntimeError(f"Cache changed while counting: {path}")
+    report["cache_hashes_unchanged_after_count"] = True
+    print(json.dumps(report, indent=2, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
