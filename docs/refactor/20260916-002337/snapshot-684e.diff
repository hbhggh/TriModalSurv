+++ b/collab/20260915-population-prototypes/run_checks_tako.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+task_root=/home/wuhao/paired_population/20260915-684e
+task_python="$task_root/env-clean/bin/python"
+mode=${1:?unit/cpu/gpu}
+run_id=${2:?unique run ID}
+[[ "$run_id" =~ ^[A-Za-z0-9_-]+$ ]]
+cd "$task_root/src"
+export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
+export NPJ_FUSION_BASELINE="$task_root/fusion_baseline.py"
+if [[ "$mode" == unit ]]; then
+    export CUDA_VISIBLE_DEVICES=''
+    "$task_python" -m pytest -p no:cacheprovider -q tests/test_population_prototypes.py \
+        tests/test_population_runtime.py tests/test_population_entrypoints.py tests/test_mean_fusion.py
+elif [[ "$mode" == cpu ]]; then
+    export CUDA_VISIBLE_DEVICES='' ACCELERATE_USE_CPU=true
+    timeout 180 "$task_python" -m torch.distributed.run --standalone --nproc_per_node=2 \
+        tests/population_smoke.py --cpu --out "$task_root/$run_id"
+elif [[ "$mode" == gpu ]]; then
+    task_gpus=${3:?two comma-separated GPU IDs}
+    [[ "$task_gpus" =~ ^[0-9]+,[0-9]+$ ]]
+    IFS=, read -r first_gpu second_gpu <<< "$task_gpus"
+    [[ "$first_gpu" != "$second_gpu" ]]
+    for task_gpu in "$first_gpu" "$second_gpu"; do
+        task_usage=$(nvidia-smi -i "$task_gpu" --query-gpu=memory.used,utilization.gpu --format=csv,noheader,nounits)
+        IFS=, read -r task_memory task_util <<< "$task_usage"
+        if (( task_memory > 512 || task_util > 5 )); then
+            echo "GPU_BUSY: $task_gpu memory=$task_memory util=$task_util" >&2
+            exit 3
+        fi
+    done
+    export CUDA_VISIBLE_DEVICES="$task_gpus"
+    unset ACCELERATE_USE_CPU
+    timeout 180 "$task_python" -m torch.distributed.run --standalone --nproc_per_node=2 \
+        tests/population_smoke.py --out "$task_root/$run_id"
+else
+    echo "Unknown check mode: $mode" >&2
+    exit 2
+fi
