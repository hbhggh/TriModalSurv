@@ -0,0 +1,66 @@
+"""验证私有缓存的患者集合、全量shape/有限值与已核标签；仅输出JSON。"""
+import hashlib
+import json
+import os
+import pickle
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+ROOT = Path(os.environ.get('NPJ_POPULATION_ROOT', '/home/wuhao/paired_population/20260915-684e')) / 'src'
+CANCERS = ('BLCA', 'BRCA', 'LGG', 'LUAD', 'UCEC')
+SHAPES = {'img': (128, 1536), 'rna': (2048, 256), 'text': (200, 768)}
+
+
+def digest(path):
+    h = hashlib.sha256()
+    with path.open('rb') as handle:
+        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def main():
+    label = ROOT / 'data/TCGA_9523_ex12.csv'
+    manifest = ROOT / 'data/missing_manifest_v1.csv'
+    assert digest(label) == '35c2865914d1e32f077ab470d299fc712d4f5fb2e63059f6bf8a68694a347e2f'
+    assert digest(manifest) == 'c789eae9a5b1517d82cfa137a92dfa8cc7ffae58e5f300163b25729ffc5d8156'
+    table = pd.read_csv(label)
+    selected = table[table.cancer_type.isin(CANCERS)]
+    assert not selected.patient_id.duplicated().any(), 'Duplicate patients across cancer/splits'
+    assert set(selected.split) == {'train', 'valid', 'test'}
+    rows, files = [], []
+    for cancer in CANCERS:
+        for split in ('train', 'valid', 'test'):
+            frame = selected[(selected.cancer_type == cancer) & (selected.split == split)]
+            patients = set(frame.patient_id)
+            assert patients
+            keys = {}
+            for modality, expected_shape in SHAPES.items():
+                path = ROOT / 'tmp_sur_cache' / f'{modality}_sur_{split}_all_{cancer}.pkl'
+                assert path.is_file() and not path.is_symlink(), str(path)
+                before = digest(path)
+                with path.open('rb') as handle:
+                    data = pickle.load(handle)
+                keys[modality] = set(data)
+                assert keys[modality] <= patients, f'Foreign patient in {path}'
+                if modality == 'img':
+                    assert keys[modality] == patients, f'WSI coverage gap in {path}'
+                for patient, value in data.items():
+                    value = np.asarray(value)
+                    assert value.shape == expected_shape, f'Wrong shape: {path} {patient}'
+                    assert np.isfinite(value).all(), f'Nonfinite: {path} {patient}'
+                del data
+                assert digest(path) == before, f'Cache changed during verification: {path}'
+                files.append(dict(file=path.name, sha256=before, patients=len(keys[modality])))
+            complete = len(set.intersection(*keys.values()))
+            assert split != 'train' or complete >= 8
+            rows.append(dict(cancer=cancer, split=split, patients=len(patients), complete=complete))
+    print(json.dumps(dict(status='passed', label_sha256=digest(label),
+                         manifest_sha256=digest(manifest), files=files, rows=rows,
+                         scope='private cache full shape/finite/identity audit; not training'), indent=2))
+
+
+if __name__ == '__main__':
+    main()
