+#!/usr/bin/env bash
+# 仅复制已经核验的缓存；不计算特征，不写共享源，不启动训练。
+set -euo pipefail
+task_src=/home/wuhao/paired_population/20260915-684e/src
+task_target=tako
+test -d /home/wuhao/NPJ/tmp_sur_cache
+ssh -o ClearAllForwardings=yes "$task_target" "test ! -e '$task_src/data' && test ! -e '$task_src/tmp_sur_cache' && mkdir '$task_src/data' '$task_src/tmp_sur_cache'"
+rsync -a -e 'ssh -o ClearAllForwardings=yes' \
+  /home/wuhao/NPJ/data/TCGA_9523_ex12.csv /home/wuhao/NPJ/data/missing_manifest_v1.csv \
+  "$task_target:$task_src/data/"
+for cancer in BLCA BRCA LGG LUAD UCEC; do
+  for split in train valid test; do
+    for modality in img rna text; do
+      task_file="${modality}_sur_${split}_all_${cancer}.pkl"
+      task_source="/home/wuhao/NPJ/tmp_sur_cache/$task_file"
+      test -f "$task_source"
+      rsync -a -e 'ssh -o ClearAllForwardings=yes' "$task_source" "$task_target:$task_src/tmp_sur_cache/"
+      source_hash=$(sha256sum "$task_source")
+      target_hash=$(ssh -o ClearAllForwardings=yes "$task_target" "sha256sum '$task_src/tmp_sur_cache/$task_file'")
+      test "${source_hash%% *}" = "${target_hash%% *}"
+      echo "CACHE_COPY_VERIFIED $task_file ${source_hash%% *}"
+    done
