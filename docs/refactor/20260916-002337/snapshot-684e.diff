+"""核对实际正式launcher干跑的25个训练/评测命令，不执行命令。"""
+import json
+import shlex
+import sys
+from pathlib import Path
+
+root = Path(__file__).resolve().parent
+source = Path(sys.argv[1]) if len(sys.argv) > 1 else root / 'evidence/formal-dry-run.txt'
+lines = source.read_text().splitlines()
+train, evaluate = [], []
+for line in lines:
+    if line.startswith(('DRY_RUN ', 'DRY_RUN_EVAL ')):
+        command = shlex.split(line.split(' command=', 1)[1])
+        flags = dict(zip(command[2::2], command[3::2]))
+        assert flags['--compensator'] == 'population' and flags['--prototype-k'] == '8'
+        assert flags['--network_type'] == 'NPJC'
+        if line.startswith('DRY_RUN '):
+            for key, value in {'--epochs': '100', '--early-stopping-patience': '15',
+                               '--lr': '0.0001', '--batch_size': '32', '--hidden_size': '256'}.items():
+                assert flags[key] == value, (key, flags)
+            assert 'slot=0 ' in line and '/out_population_k8/' in line
+            train.append((flags['--cancer_types'], int(flags['--seed'])))
+        else:
+            assert flags['--grids'] == 'all' and flags['--arm'] == 'm0real'
+            evaluate.append((flags['--cancer'], int(flags['--seed'])))
+expected = {(c, s) for c in ('BLCA', 'BRCA', 'LGG', 'LUAD', 'UCEC')
+            for s in (123, 132, 213, 231, 321)}
+assert len(train) == len(evaluate) == 25
+assert set(train) == set(evaluate) == expected
+print(json.dumps(dict(status='passed', training_commands=25, evaluation_commands=25,
+                      K=8, max_epochs=100, patience=15, lr=.0001, batch_size=32)))
