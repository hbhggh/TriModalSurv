@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# 外层必须由 landau jobrun.sh 托管；历史文件名保留，路径和 Python 可显式覆盖。
+# 用户允许四平台空卡或利用率 <40% 的卡；本脚本不抢占/终止其他任务。
+set -euo pipefail
+task_gpu=${1:?one physical GPU ID}
+[[ "$task_gpu" =~ ^[0-9]+$ ]]
+task_mode=${2:-run}
+[[ "$task_mode" == run || "$task_mode" == dry-run ]]
+task_root=${NPJ_POPULATION_ROOT:-/home/wuhao/paired_population/20260915-684e}
+task_python=${NPJ_POPULATION_PYTHON:-/home/wuhao/miniconda3/envs/tcga_env/bin/python}
+cd "$task_root/src"
+export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
+if [[ "$task_mode" == run ]]; then
+  task_usage=$(nvidia-smi -i "$task_gpu" --query-gpu=memory.used,memory.free,utilization.gpu --format=csv,noheader,nounits)
+  task_pattern='^[[:blank:]]*([0-9]+)[[:blank:]]*,[[:blank:]]*([0-9]+)[[:blank:]]*,[[:blank:]]*([0-9]+)[[:blank:]]*$'
+  if [[ ! "$task_usage" =~ $task_pattern ]]; then
+    echo "GPU_QUERY_INVALID: $task_usage" >&2
+    exit 3
+  fi
+  task_memory=$((10#${BASH_REMATCH[1]}))
+  task_free=$((10#${BASH_REMATCH[2]}))
+  task_util=$((10#${BASH_REMATCH[3]}))
+  if (( task_util >= 40 || task_free == 0 )); then
+    echo "GPU_BUSY: $task_gpu memory=$task_memory free=$task_free util=$task_util" >&2
+    exit 3
+  fi
+  # 启动前仍需核对本任务显存需求；整卡 util 不能归因为本任务利用率。
+  echo "GPU_ADMISSION: gpu=$task_gpu used_mib=$task_memory free_mib=$task_free util=$task_util policy=below_40_percent shared_gpu_allowed=true"
+fi
+task_extra=()
+[[ "$task_mode" != dry-run ]] || task_extra+=(--dry_run)
+exec "$task_python" -B scripts/train_launcher.py \
+  --arms population --prototype-k 8 \
+  --cancers BLCA,BRCA,LGG,LUAD,UCEC --seeds 123,132,213,231,321 \
+  --epochs 100 --early-stopping-patience 15 --lr 0.0001 --batch-size 32 \
+  --gpus "$task_gpu" --per_gpu 1 --prewarm_workers 1 --eval_workers 1 \
+  --label "$task_root/src/data/TCGA_9523_ex12.csv" \
+  --model-config "$task_root/src/model/config/surv_multimodal_mainmoe_uni2.yml" \
+  --gpu-config "$task_root/src/config/gpu_train.yaml" \
+  --cache-dir "$task_root/src/tmp_sur_cache" \
+  --result-path "$task_root/formal-k8-es15-e100-v1/out" --cpt-name tcga_uni2 \
+  --logs-dir "$task_root/formal-k8-es15-e100-v1/logs" \
+  --state-file "$task_root/formal-k8-es15-e100-v1/runs_state.json" \
+  --eval-grids all --eval-manifest "$task_root/src/data/missing_manifest_v1.csv" \
+  --eval-out "$task_root/formal-k8-es15-e100-v1/eval" ${task_extra[@]+"${task_extra[@]}"}
