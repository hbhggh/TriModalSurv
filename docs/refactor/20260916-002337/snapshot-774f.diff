+def configure_missing_grid_inplace(
+    dataset,
+    manifest_path: Path,
+    grid: str,
+    cancer: str,
+) -> Set[str]:
+    """在同一个 dataset 上切换缺失格点，并返回应被遮挡的患者集合。"""
+    mode, rate = grid_parts(grid)
