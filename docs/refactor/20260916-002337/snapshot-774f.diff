+GRID_OFFSET = {"none": 0.10, "rna_100": 0.0, "text_100": 0.02, "both_100": -0.02}
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(8192), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
