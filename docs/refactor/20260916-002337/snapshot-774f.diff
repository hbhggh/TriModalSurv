+"""只读解析历史 E0 日志：证明 seed/保存路径关联，不伪造训练时权重哈希。"""
+import hashlib
+import json
+import re
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+CANCERS = ('BLCA', 'BRCA', 'LGG', 'LUAD', 'UCEC')
+SEEDS = (123, 132, 213, 231, 321)
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def audit():
+    preflight = json.loads((HERE.parent / 'padding-v2/evidence/preflight/diagnostics/preflight.json').read_text())
+    result = {}
+    for cancer in CANCERS:
+        log_path = HERE / 'provenance/logs' / f'c_e0_{cancer.lower()}.log'
+        # 保持原始 LF 行号；CR 进度条不计作新的源码引用行。
+        text = log_path.read_bytes().decode()
+        matches = list(re.finditer(r'Training Arguments: Namespace\(seed=(\d+),[^\n]*', text))
+        assert [int(m.group(1)) for m in matches] == list(SEEDS), cancer
+        assert f'C_UNIT_e0_{cancer}_DONE' in text
+        assert not re.search(r'SEED_\d+_FAILED|TWO_FAILS_STOP|Traceback \(most recent call last\)', text)
+        job_dir = HERE / 'provenance/jobs' / f'c_e0_{cancer.lower()}'
+        job = json.loads((job_dir / 'job.json').read_text())
+        assert f'e0 {cancer}' in job['cmd']
+        assert (job_dir / 'done.flag').exists() and not (job_dir / 'fail.flag').exists()
+        rows = []
+        for index, match in enumerate(matches):
+            seed = int(match.group(1))
+            header = match.group(0)
+            for field in ("network_type='NPJC'", "compensator='none'", "result_path='out'",
+                          f"cancer_types='{cancer}'", 'train=True', 'n_image_tokens=128'):
+                assert field in header, (cancer, seed, field)
+            end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
+            block = text[match.start():end]
+            expected = f'out/{seed}/tcga_uni2_img_1536text_768rna_256_NPJC_{cancer}_surv.pth'
+            saves = re.findall(r'Saving model checkpoint to:\s+(\S+)', block)
+            assert saves and set(saves) == {expected}, (cancer, seed)
+            metrics = expected.removesuffix('.pth') + '_results.json'
+            assert f'Saving single result metrics to: {metrics}' in block
+            current = preflight['reports'][cancer]['checkpoints'][str(seed)]
+            assert current['path'] == '/home/wuhao/NPJ/' + expected
+            assert current['strict_load']
+            rows.append({'seed': seed, 'training_arguments_line': text.count('\n', 0, match.start()) + 1,
+                         'checkpoint_path_from_log': expected, 'checkpoint_save_events': len(saves),
+                         'completed_metrics_path_from_log': metrics,
+                         'current_preflight_file_sha256': current['sha256'],
+                         'current_preflight_state_sha256': current['state_sha256'],
+                         'training_time_file_sha256': None})
+        result[cancer] = {'log_path': str(log_path.relative_to(HERE)), 'log_sha256': digest(log_path),
+                          'job_command': job['cmd'], 'job_start_ts': job['start_ts'],
+                          'done_flag': (job_dir / 'done.flag').read_text().strip(), 'seeds': rows}
+    return {'log_linkage_status': 'PASS', 'covered_checkpoints': 25, 'cancers': result,
+            'content_identity_status': 'NOT_PROVEN_BY_THESE_LOGS',
+            'note': '历史命令/保存路径/完成记录与当前目录25/25关联；当前preflight哈希不是训练时哈希，不能证明此后未互换或覆盖。'}
+
+
+if __name__ == '__main__':
+    print(json.dumps(audit(), ensure_ascii=False, indent=2))
