+"""只读 Claude CLI 互审的留档包装，不负责实验启动或授权。"""
+import datetime
+import argparse
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, default=HERE / 'claude-review-r1')
+    parser.add_argument('--request', type=Path, default=HERE / 'claude-review-request.md')
+    args = parser.parse_args()
+    output = args.output.resolve()
+    output.mkdir(exist_ok=False)
+    prompt = args.request.read_text()
+    command = ['/opt/homebrew/bin/claude', '-p', '--model', 'opus', '--effort', 'high',
+               '--permission-mode', 'dontAsk', '--tools', 'Read,Glob,Grep',
+               '--allowedTools', 'Read,Glob,Grep', '--disallowedTools', 'Bash,Edit,Write,Agent',
+               '--disable-slash-commands', '--no-chrome', '--strict-mcp-config',
+               '--mcp-config', '{"mcpServers":{}}', '--settings', '{"disableAllHooks":true}',
+               '--output-format', 'stream-json', '--verbose']
+    metadata = {'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                'cwd': str(ROOT), 'command': command,
+                'prompt_sha256': hashlib.sha256(prompt.encode()).hexdigest()}
+    with (output / 'stdout.jsonl').open('x') as stdout, (output / 'stderr.log').open('x') as stderr:
+        process = subprocess.Popen(command, cwd=ROOT, stdin=subprocess.PIPE, stdout=stdout,
+                                   stderr=stderr, text=True, start_new_session=True)
+        metadata['pid'] = process.pid
+        (output / 'launch.json').write_text(json.dumps(metadata, ensure_ascii=False, indent=2))
+        print(f'Claude 只读互审已启动 PID={process.pid}，留档={output}', flush=True)
+        process.communicate(prompt)
+    result = {'returncode': process.returncode,
+              'finished_utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
+    (output / 'exit.json').write_text(json.dumps(result, indent=2))
+    print(json.dumps(result), flush=True)
+    return process.returncode
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
