+"""本地只读核验 padding-v2 留档与当前源码，不补写或更新历史哈希。"""
+import hashlib
+import importlib.util
+import json
+import re
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+CODE = HERE.parents[2] / 'code/NPJ'
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    spec = importlib.util.spec_from_file_location('old_evidence_checker', HERE.parent / 'verify_evidence.py')
+    old = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(old)
+    old.EVIDENCE = HERE / 'evidence'
+    summary = old.verify_smoke('smoke')
+    assert set(summary) == {'BLCA', 'BRCA', 'LGG', 'LUAD', 'UCEC'}
+    assert all(v['legacy_unknown_grids'] == 0 for v in summary.values())
+    real = read(HERE / 'evidence/verification.json')
+    assert real['status'] == 'PASS' and real['protocol_id'] == 'patient-fixed-padmask-v2'
+    assert real['formal_cindex_count'] == 0 and set(real['cancers']) == set(summary)
+    assert real['script_sha256'] == sha(HERE / 'verify_real.py')
+    pre = read(HERE / 'evidence/preflight/diagnostics/preflight.json')
+    assert not pre['failures'] and set(pre['reports']) == set(summary)
+    assert pre['protocol_id'] == 'patient-fixed-padmask-v2'
+    old.verify_source_hashes(pre['reports'], CODE)
+    smoke = read(HERE / 'evidence/smoke/diagnostics/preflight.json')
+    old.verify_source_hashes(smoke['reports'], CODE)
+    checkpoints = 0
+    for cancer, report in pre['reports'].items():
+        assert set(report['checkpoints']) == old.SEEDS
+        assert len({v['state_sha256'] for v in report['checkpoints'].values()}) == 5
+        assert all(v['strict_load'] for v in report['checkpoints'].values())
+        assert report['provenance'] == smoke['reports'][cancer]['provenance']
+        assert report['checkpoints']['123'] == smoke['reports'][cancer]['checkpoints']['123']
+        checkpoints += 5
+        diagnosis = real['cancers'][cancer]
+        assert diagnosis['status'] == 'PASS' and diagnosis['model_and_raw_features_unchanged']
+        assert diagnosis['m0real_m1_reference_max_logit_abs_diff'] <= 1e-6
+        assert len(diagnosis['train_leave_one_out']) == (6 if cancer == 'LGG' else 0)
+        for unit_path in (HERE / 'evidence/smoke/smoke').glob(f'*_{cancer}_s123.json'):
+            unit = read(unit_path)
+            assert unit['protocol_id'] == 'patient-fixed-padmask-v2'
+            for grid, result in unit['grids'].items():
+                assert result['n_complete_checked'] == diagnosis['complete_checked_per_grid'][grid]
+                rows = read(HERE / 'evidence/smoke' / result['audit_file'])
+                assert [r['patient_id'] for r in rows] == diagnosis['test_ids']
+                for row in rows:
+                    qn = diagnosis['padded']['test'].get(row['patient_id'], 128)
+                    assert row['query_valid_rows'] == qn
+                    if row['donor_id'] is None:
+                        assert row['donor_valid_rows'] is None and row['common_valid_rows'] is None
+                    else:
+                        dn = report['provenance']['bank']['valid_row_counts'][row['donor_id']]
+                        assert row['donor_valid_rows'] == dn
+                        assert row['common_valid_rows'] == min(qn, dn)
+    assert checkpoints == 25
+    for name in ('preflight', 'smoke', 'verify'):
+        job = HERE / 'evidence/jobs' / f'padmask_v2_{name}_kyAwyQ'
+        assert (job / 'done.flag').is_file() and not (job / 'fail.flag').exists()
+        assert not (job / 'running.flag').exists()
+    log = (HERE / 'remote-tests-final.log').read_text()
+    assert re.search(r'Ran 59 tests .*\n\nOK\s*$', log)
+    assert 'skipped=' not in log
+    for record_path in HERE.glob('*.json'):
+        record = read(record_path)
+        if 'log_sha256' in record:
+            assert sha(record_path.with_suffix('.log')) == record['log_sha256']
+    deployed = []
+    for line in (HERE / 'deployed-hashes.log').read_text().splitlines():
+        expected, relative = line.split(maxsplit=1)
+        relative = relative.removeprefix('./')
+        target = HERE / relative if relative == 'verify_real.py' else CODE / relative
+        assert sha(target) == expected, f'deployed mismatch: {relative}'
+        deployed.append(relative)
+    assert set(deployed) == {str(p.relative_to(CODE)) for p in CODE.rglob('*.py')} | {'verify_real.py'}
+    changed = []
+    for before in (HERE / 'source-before').rglob('*'):
+        if before.is_file():
+            relative = before.relative_to(HERE / 'source-before')
+            after = CODE / relative
+            assert after.exists()
+            if sha(before) != sha(after):
+                changed.append(str(relative))
+    expected_changed = {'model/patient_retrieval_bank.py', 'scripts/eval_patient_retrieval.py',
+                        'scripts/summarize_patient_retrieval.py', 'tests/test_patient_retrieval_eval.py',
+                        'tests/test_patient_retrieval_summary.py'}
+    assert set(changed) == expected_changed
+    assert sha(CODE / 'model/fusion_model.py') == sha(HERE / 'source-before/model/fusion_model.py')
+    assert sha(CODE / 'main_survival.py') == sha(HERE / 'source-before/main_survival.py')
+    print(json.dumps({'status': 'PASS', 'checkpoint_count': checkpoints, 'remote_tests': 59,
+                      'torch_skipped': 0, 'smoke': summary, 'formal_cindex_count': 0,
+                      'changed_existing_code': sorted(changed),
+                      'new_code': ['tests/test_patient_retrieval_padding.py'],
+                      'deployed_python_files': len(deployed)}, indent=2, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    main()
