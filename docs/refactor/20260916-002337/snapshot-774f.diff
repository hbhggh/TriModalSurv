+"""旧证据不得被误读为新检查，来源哈希不得被放宽。"""
+import hashlib
+import importlib.util
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('report_evidence', HERE.parent / 'verify_evidence.py')
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class EvidenceDiagnosticsTest(unittest.TestCase):
+    def test_legacy_smoke_is_explicitly_unknown_not_zero_error(self):
+        summary = module.verify_smoke('smoke-v3')
+        self.assertEqual(summary['BRCA']['complete_max_abs_diff'], None)
+        self.assertEqual(summary['BRCA']['legacy_unknown_grids'], 12)
+
+    def test_source_hash_mismatch_is_not_bypassed(self):
+        self.assertTrue(hasattr(module, 'verify_source_hashes'), '需要显式来源根目录哈希核验接口')
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            path = root / 'example.py'
+            path.write_text('original')
+            reports = {'BLCA': {'provenance': {'source_hashes': {
+                'example.py': hashlib.sha256(b'original').hexdigest()}}}}
+            module.verify_source_hashes(reports, root)
+            path.write_text('changed')
+            with self.assertRaisesRegex(AssertionError, 'example.py'):
+                module.verify_source_hashes(reports, root)
+
+    def test_new_evidence_preserves_null_and_checks_actual_count(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            shutil.copytree(module.EVIDENCE / 'smoke-v3', root / 'new-format')
+            base = root / 'new-format'
+            for path in (base / 'smoke').glob('*.json'):
+                unit = json.loads(path.read_text())
+                for grid, result in unit['grids'].items():
+                    audit = json.loads((base / result['audit_file']).read_text())
+                    count = sum(row['original_valid']['rna'] and row['original_valid']['text']
+                                for row in audit)
+                    result['n_complete_checked'] = count
+                    result['complete_max_logit_abs_diff'] = 0.0 if count else None
+                path.write_text(json.dumps(unit))
+            with patch.object(module, 'EVIDENCE', root):
+                summary = module.verify_smoke('new-format')['BRCA']
+                self.assertEqual(summary['legacy_unknown_grids'], 0)
+                self.assertEqual(summary['complete_max_abs_diff'], 0.0)
+                path = base / 'smoke/m1_BRCA_s123.json'
+                unit = json.loads(path.read_text())
+                unit['grids']['none'].update(n_complete_checked=0, complete_max_logit_abs_diff=None)
+                path.write_text(json.dumps(unit))
+                with self.assertRaises(AssertionError):
+                    module.verify_smoke('new-format')
+
+
+if __name__ == '__main__':
+    unittest.main()
