+def build_eval_command(
+    args: argparse.Namespace,
+    spec: RunSpec,
+    checkpoint: Path,
+    out_dir: Path,
+) -> List[str]:
+    """组装 eval_missing.py 命令（纯函数，无副作用，便于 dry-run 断言）。"""
+    command = [
+        args.python,
+        str(EVAL_SCRIPT),
+        "--arm",
