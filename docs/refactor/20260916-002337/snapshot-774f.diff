+"""只读核验正式元数据和汇总，不改变评测结果；证据独占创建。"""
+import hashlib
+import json
+import math
+import statistics
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent
+CANCERS = ('BLCA', 'BRCA', 'LGG', 'LUAD', 'UCEC')
+SEEDS = (123, 132, 213, 231, 321)
+ARMS = ('m0real', 'm1', 'retrieval')
+MISSING = ('rna_100', 'text_100', 'both_100')
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def main():
+    units = {}
+    review_sha = hashlib.sha256((ROOT / 'claude-launch-review/report.md').read_bytes()).hexdigest()
+    assert review_sha == '657f362286eadcbe966f9cb65feb5055c1aa4e3232d4b7a3d9e4cf36171a4ad6'
+    for cancer in CANCERS:
+        checkpoint_hashes = set()
+        for seed in SEEDS:
+            paired = []
+            for arm in ARMS:
+                unit = read(ROOT / f'evidence/formal/{arm}_{cancer}_s{seed}.json')
+                assert unit['protocol_id'] == 'patient-fixed-padmask-v2'
+                assert unit['review_record_sha256'] == review_sha
+                assert unit['stage'] == 'formal'
+                units[cancer, seed, arm] = unit
+                paired.append(unit['checkpoint_sha256'])
+            assert len(set(paired)) == 1
+            checkpoint_hashes.add(paired[0])
+        assert len(checkpoint_hashes) == 5
+    for seed in SEEDS:
+        scores = [units['BLCA', seed, arm]['grids']['none']['cindex_B'] for arm in ARMS]
+        assert len(set(scores)) == 1
+        for arm in ARMS:
+            grid = units['BLCA', seed, arm]['grids']['none']
+            assert grid['n_complete_checked'] == 138
+            assert grid['complete_max_logit_abs_diff'] == 0
+    markers = (
+        'e590f706a607e48d62caaa258f035eb136b2c0c11828dde4aa01b246f6921a70',
+        'c5c674f69ae04e49748d7a73187a22d651a511493bdceb20e251d67f0624f11a',
+    )
+    for filename in ('formal.log', 'smoke-r2.log'):
+        content = (ROOT / filename).read_text()
+        assert all(marker in content for marker in markers), filename
+    summary = read(ROOT / 'evidence/summary/summary.json')
+    overview = summary['overview_missing_only']
+    assert overview['grids'] == list(MISSING)
+    close = lambda a, b: math.isclose(a, b, rel_tol=0, abs_tol=1e-14)
+    for arm in ARMS:
+        values = [units[c, s, arm]['grids'][g]['cindex_B'] for c in CANCERS for g in MISSING for s in SEEDS]
+        assert close(statistics.fmean(values), overview['arms'][arm])
+    for cell in summary['per_cell']:
+        values = [units[cell['cancer'], s, cell['arm']]['grids'][cell['grid']]['cindex_B'] for s in SEEDS]
+        assert close(statistics.fmean(values), cell['mean'])
+        assert close(statistics.stdev(values), cell['sample_std'])
+    for item in summary['contrasts']:
+        baseline = item['contrast'].removeprefix('retrieval-minus-')
+        values = [units[item['cancer'], s, 'retrieval']['grids'][item['grid']]['cindex_B'] - units[item['cancer'], s, baseline]['grids'][item['grid']]['cindex_B'] for s in SEEDS]
+        assert values == item['deltas']
+        assert close(statistics.fmean(values), item['mean'])
+        assert close(statistics.stdev(values), item['sample_std'])
+        assert (sum(v > 0 for v in values), sum(v == 0 for v in values), sum(v < 0 for v in values)) == (item['wins'], item['ties'], item['losses'])
+    for baseline in ('m1', 'm0real'):
+        assert close(overview['contrasts'][f'retrieval-minus-{baseline}'], overview['arms']['retrieval'] - overview['arms'][baseline])
+    for item in summary['worst_missing_grid']:
+        cells = [c for c in summary['per_cell'] if c['cancer'] == item['cancer'] and c['arm'] == item['arm'] and c['grid'] in MISSING]
+        worst = min(cells, key=lambda c: c['mean'])
+        assert (item['grid'], item['mean']) == (worst['grid'], worst['mean'])
+    result = dict(status='PASS', units=len(units), protocol_id='patient-fixed-padmask-v2', review_record_sha256=review_sha,
+                  paired_checkpoint_check='PASS', launch_hashes_match_smoke=True, blca_none_exact_equal=True,
+                  summary_recomputed=True, overview_missing_only=overview)
+    with (ROOT / 'metadata-check.json').open('x') as handle:
+        json.dump(result, handle, indent=2)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()
