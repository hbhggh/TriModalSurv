+"""独立读取预测和audit，复算风险/指标并核对患者、mask、供体与检查人数。"""
+import argparse
+import csv
+import hashlib
+import json
+import pickle
+from pathlib import Path
+
+import numpy as np
+import torch
+from sksurv.metrics import concordance_index_censored
+
+CANCERS = ('BLCA', 'BRCA', 'LGG', 'LUAD', 'UCEC')
+SEEDS = (123, 132, 213, 231, 321)
+ARMS = ('m0real', 'm1', 'retrieval')
+GRIDS = ('none', 'rna_100', 'text_100', 'both_100')
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--run', type=Path, required=True)
+    p.add_argument('--assets', type=Path, required=True)
+    p.add_argument('--baseline', type=Path, required=True)
+    p.add_argument('--out', type=Path, required=True)
+    a = p.parse_args()
+    state = read(a.run / 'diagnostics/campaign_status.json')
+    assert state['status'] == 'COMPLETED', state
+    stage = state['stage']
+    assert stage in ('smoke', 'formal')
+    units_dir = a.run if stage == 'formal' else a.run / 'smoke'
+    baseline = read(a.baseline)
+    with (a.assets / 'data/TCGA_9523_ex12.csv').open() as f:
+        labels = list(csv.DictReader(f))
+    summary = {'stage': stage, 'units': 0, 'grids': 0, 'prediction_rows': 0,
+               'cindex_recomputed': 0, 'max_complete_logit_diff': 0.0, 'cancers': {}}
+    for cancer in CANCERS:
+        rows = {r['patient_id']: r for r in labels if r['cancer_type'] == cancer and r['split'] == 'test'}
+        train_ids = {r['patient_id'] for r in labels if r['cancer_type'] == cancer and r['split'] == 'train'}
+        available = {}
+        for split in ('train', 'test'):
+            for mm in ('rna', 'text'):
+                with (a.assets / 'tmp_sur_cache' / f'{mm}_sur_{split}_all_{cancer}.pkl').open('rb') as f:
+                    cache = pickle.load(f)
+                available[(split, mm)] = {pid for pid, x in cache.items() if x is not None}
+                del cache
+        stable_audits = {}
+        for seed in SEEDS:
+            units = {arm: read(units_dir / f'{arm}_{cancer}_s{seed}.json') for arm in ARMS}
+            for arm, unit in units.items():
+                assert (unit['arm'], unit['cancer'], unit['seed'], unit['stage'], unit['device']) == (arm, cancer, seed, stage, 'cuda')
+                assert unit['checkpoint_sha256'] == baseline['reports'][cancer]['checkpoints'][str(seed)]['sha256']
+                assert set(unit['grids']) == set(GRIDS)
+                summary['units'] += 1
+            for grid in GRIDS:
+                logits_by_arm = {}
+                ids_reference = None
+                complete = None
+                for arm, unit in units.items():
+                    meta = unit['grids'][grid]
+                    pred_path, audit_path = (a.run / meta[k] for k in ('predictions_file', 'audit_file'))
+                    assert sha(pred_path) == meta['predictions_sha256']
+                    assert sha(audit_path) == meta['audit_sha256']
+                    with np.load(pred_path, allow_pickle=False) as z:
+                        ids, logits = z['patient_id'].tolist(), z['logits'].copy()
+                        times, censor, risk = (z[k].copy() for k in ('survival_months', 'censorship', 'risk_B'))
+                    assert ids == sorted(set(ids)) and set(ids).issubset(rows)
+                    assert len(ids) == meta['n_test']
+                    if stage == 'formal':
+                        assert ids == sorted(rows)
+                    assert not set(ids) & train_ids
+                    assert np.array_equal(times, np.array([float(rows[i]['survival_months']) for i in ids], dtype=np.float32))
+                    assert np.array_equal(censor, np.array([float(rows[i]['censorship']) for i in ids], dtype=np.float32))
+                    assert logits.shape == (len(ids), 4) and np.isfinite(logits).all()
+                    h = torch.sigmoid(torch.from_numpy(logits)).clamp(1e-6, 1 - 1e-6)
+                    recalculated = -(1 - h).cumprod(1).sum(1).numpy()
+                    assert np.array_equal(risk, recalculated)
+                    if stage == 'formal':
+                        score = float(concordance_index_censored((1-censor).astype(bool), times, recalculated)[0])
+                        assert score == meta['cindex_B']
+                        summary['cindex_recomputed'] += 1
+                    else:
+                        assert 'cindex_B' not in meta
+                    audit = read(audit_path)
+                    assert [r['patient_id'] for r in audit] == ids
+                    if ids_reference is not None:
+                        assert ids == ids_reference
+                    ids_reference = ids
+                    complete = np.array([grid == 'none' and all(i in available[('test', m)] for m in ('rna', 'text')) for i in ids])
+                    for rec in audit:
+                        pid = rec['patient_id']
+                        need = []
+                        for mm in ('rna', 'text'):
+                            natural = pid in available[('test', mm)]
+                            original = natural and grid not in (mm + '_100', 'both_100')
+                            assert rec['natural_valid'][mm] == natural and rec['original_valid'][mm] == original
+                            assert rec['fusion_valid'][mm] == (original if arm == 'm0real' else True)
+                            if not original:
+                                need.append(mm)
+                        if arm == 'retrieval' and need:
+                            candidates = train_ids.intersection(*(available[('train', m)] for m in need)) - {pid}
+                            assert rec['donor_id'] in candidates and rec['candidate_count'] == len(candidates)
+                            assert np.isfinite(rec['similarity']) and -1.00000001 <= rec['similarity'] <= 1.00000001
+                        else:
+                            assert rec['donor_id'] is None
+                    if arm == 'retrieval':
+                        if grid in stable_audits:
+                            assert audit == stable_audits[grid]
+                        stable_audits[grid] = audit
+                    assert meta['n_complete_checked'] == int(complete.sum())
+                    assert meta['complete_logit_atol'] == 1e-6
+                    logits_by_arm[arm] = logits
+                    summary['grids'] += 1
+                    summary['prediction_rows'] += len(ids)
+                delta = max(float(np.max(np.abs(logits_by_arm[x][complete] - logits_by_arm['m0real'][complete]))) for x in ('m1', 'retrieval')) if complete.any() else None
+                assert delta is None or delta <= 1e-6
+                for unit in units.values():
+                    assert unit['grids'][grid]['complete_max_logit_abs_diff'] == delta
+                summary['max_complete_logit_diff'] = max(summary['max_complete_logit_diff'], delta or 0)
+        summary['cancers'][cancer] = {'n_full_test': len(rows), 'n_checked_per_grid': len(ids_reference)}
+    assert summary['units'] == 75 and summary['grids'] == 300
+    assert len(list(units_dir.glob('*_s*.json'))) == 75
+    summary['status'] = 'PASS'
+    with a.out.open('x') as f:
+        json.dump(summary, f, indent=2)
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == '__main__':
+    main()
