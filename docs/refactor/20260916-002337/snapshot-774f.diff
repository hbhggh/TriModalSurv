+"""CPU 冒烟的独立公式/输入/真实前向对拍，不计算 C-index，不改原缓存。"""
+import argparse
+import gc
+import hashlib
+import json
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def sha(path):
+    h = hashlib.sha256()
+    with path.open('rb') as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def array_sha(value):
+    a = np.asarray(value)
+    return hashlib.sha256(str((a.shape, str(a.dtype))).encode() + a.tobytes()).hexdigest()
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--source-root', type=Path, required=True)
+    p.add_argument('--data-root', type=Path, required=True)
+    p.add_argument('--smoke-root', type=Path, required=True)
+    p.add_argument('--preflight-root', type=Path, required=True)
+    p.add_argument('--out', type=Path, required=True)
+    args = p.parse_args()
+    assert not args.out.exists(), '禁止覆盖验收证据'
+    sys.path.insert(0, str(args.source_root / 'scripts'))
+    import eval_patient_retrieval as ev
+    from summarize_patient_retrieval import validate_complete_diagnostics
+    import torch
+    torch.set_num_threads(4)
+    preflight = read(args.preflight_root / 'diagnostics/preflight.json')
+    smoke = read(args.smoke_root / 'diagnostics/preflight.json')
+    for artifact, stage in ((args.preflight_root, 'preflight'), (args.smoke_root, 'smoke')):
+        assert read(artifact / 'diagnostics/campaign_status.json') == {'stage': stage, 'status': 'COMPLETED'}
+    assert set(preflight['reports']) == set(smoke['reports']) == set(ev.CANCERS)
+    assert not preflight['failures'] and not smoke['failures']
+    assert preflight['protocol_id'] == smoke['protocol_id'] == 'patient-fixed-padmask-v2'
+    results = {}
+    options = SimpleNamespace(data_root=args.data_root, checkpoint_root=args.data_root / 'out',
+                              label=args.data_root / 'data/TCGA_9523_ex12.csv',
+                              manifest=args.data_root / 'data/missing_manifest_v1.csv',
+                              out_dir=args.smoke_root, seeds=[123])
+    expected_padded = {'BLCA': {'train': {}, 'test': {'TCGA-GC-A3WC': 123}},
+                       'LGG': {'train': {'TCGA-DU-A6S6': 124, 'TCGA-S9-A6UA': 75},
+                               'test': {'TCGA-FG-A70Y': 96}}}
+    for cancer in ev.CANCERS:
+        previous = smoke['reports'][cancer]
+        full = preflight['reports'][cancer]
+        assert set(full['checkpoints']) == {'123', '132', '213', '231', '321'}
+        assert len({v['state_sha256'] for v in full['checkpoints'].values()}) == 5
+        assert all(v['strict_load'] for v in full['checkpoints'].values())
+        for value in full['checkpoints'].values():
+            assert sha(Path(value['path'])) == value['sha256']
+        bank, source, model, current = ev.preflight_cancer(options, cancer)
+        assert current == previous
+        assert current['provenance'] == full['provenance']
+        model.eval()
+        before_weights = {k: v.clone() for k, v in model.state_dict().items()}
+        assert model.compensator is None and not any('cap' in k.lower() for k in before_weights)
+        train = bank._features  # 仅用于独立验收，不属于运行时接口。
+        hashes_before = {(m, pid): array_sha(a) for m, values in train.items() for pid, a in values.items()}
+        hashes_before.update({('test_' + m, pid): array_sha(a) for m, values in source.features.items()
+                              for pid, a in values.items() if a is not None})
+        train_counts = {pid: int(np.count_nonzero(np.any(train['img'][pid] != 0, axis=1)))
+                        for pid in bank.patient_ids}
+        test_counts = {pid: int(np.count_nonzero(np.any(source.features['img'][pid] != 0, axis=1)))
+                       for pid in source.ids}
+        padded = {'train': {pid: n for pid, n in train_counts.items() if n < 128},
+                  'test': {pid: n for pid, n in test_counts.items() if n < 128}}
+        assert padded == expected_padded.get(cancer, {'train': {}, 'test': {}})
+        # 独立求 mu；不调用生产 mask/mean/score helper。
+        mu = np.zeros(1536, dtype=np.float64)
+        old_mu = np.zeros_like(mu)
+        for pid in bank.patient_ids:
+            x = train['img'][pid].astype(np.float64)
+            mu += x[:train_counts[pid]].sum(axis=0) / train_counts[pid]
+            old_mu += x.sum(axis=0) / 128
+        mu /= len(bank.patient_ids)
+        old_mu /= len(bank.patient_ids)
+        np.testing.assert_allclose(bank.mean, mu, atol=1e-12, rtol=0)
+        reference_means = {}
+        for mm in ('rna', 'text'):
+            acc = np.zeros(ev.SHAPES[mm], dtype=np.float64)
+            for value in train[mm].values():
+                acc += value
+            reference_means[mm] = acc / len(train[mm])
+            np.testing.assert_array_equal(reference_means[mm], bank.means[mm])
+        keys = {pid: train['img'][pid].astype(np.float64) - mu for pid in bank.patient_ids}
+        formula_cache = {}
+
+        def independently_select(pid, x, missing):
+            cache_key = (pid, tuple(missing))
+            if cache_key not in formula_cache:
+                count = int(np.count_nonzero(np.any(x != 0, axis=1)))
+                q = x.astype(np.float64) - mu
+                scores = []
+                for donor in sorted(bank.patient_ids):
+                    if donor == pid or not all(donor in train[m] for m in missing):
+                        continue
+                    n = min(count, train_counts[donor])
+                    a, b = q[:n], keys[donor][:n]
+                    # 参考计算使用直接 sum-of-squares；生产使用 linalg.norm。
+                    an, bn = np.sqrt(np.sum(a * a)), np.sqrt(np.sum(b * b))
+                    assert n > 0 and an > 1e-12 and bn > 1e-12
+                    score = float(np.sum(a * b) / (an * bn))
+                    assert np.isfinite(score)
+                    scores.append({'donor_id': donor, 'score': score, 'common_valid_rows': n})
+                assert scores
+                winner = max(scores, key=lambda r: r['score'])
+                formula_cache[cache_key] = (winner, scores)
+            return formula_cache[cache_key]
+
+        ids = ev.smoke_ids(source)
+        assert set(padded['test']).issubset(ids)
+        assert not set(ids).intersection(bank.patient_ids)
+        max_parity = 0.0
+        checked_inputs = 0
+        checked_retrievals = 0
+        complete_counts = {}
+        for grid in ev.GRIDS:
+            raw, natural = source.batch(ids, grid)
+            complete = raw['rna_valid'] & raw['text_valid']
+            actual_logits = {}
+            diagnostics = []
+            for arm in ev.ARMS:
+                inputs, audit = ev.prepare_batch(bank, ids, raw, natural, arm)
+                logits = ev.forward_numpy(model, inputs, cancer, 'cpu')
+                actual_logits[arm] = logits
+                unit = read(args.smoke_root / 'smoke' / f'{arm}_{cancer}_s123.json')
+                assert unit['protocol_id'] == 'patient-fixed-padmask-v2' and unit['stage'] == 'smoke'
+                assert unit['checkpoint_sha256'] == current['checkpoints']['123']['sha256']
+                result = unit['grids'][grid]
+                assert 'cindex_B' not in result
+                for name in ('predictions', 'audit'):
+                    assert sha(args.smoke_root / result[name + '_file']) == result[name + '_sha256']
+                saved = np.load(args.smoke_root / result['predictions_file'], allow_pickle=False)
+                assert saved['patient_id'].tolist() == ids
+                np.testing.assert_allclose(saved['logits'], logits, rtol=0, atol=1e-6)
+                hazards = np.clip(1 / (1 + np.exp(-saved['logits'])), 1e-6, 1 - 1e-6)
+                np.testing.assert_allclose(saved['risk_B'], -np.cumprod(1 - hazards, axis=1).sum(axis=1),
+                                           atol=1e-6, rtol=0)
+                assert read(args.smoke_root / result['audit_file']) == audit
+                check = validate_complete_diagnostics(result, grid)
+                assert check['n_complete_checked'] == int(complete.sum())
+                diagnostics.append((check['n_complete_checked'], check['complete_max_logit_abs_diff']))
+                np.testing.assert_array_equal(inputs['img'], raw['img'])
+                if arm in ('m0real', 'm1'):
+                    # 旧不补/均值填定义的独立参考，不绕开旧 v1 guard 冒充全流程通过。
+                    reference = {k: a.copy() for k, a in raw.items()}
+                    if arm == 'm1':
+                        for mm in ('rna', 'text'):
+                            missing_rows = ~raw[mm + '_valid']
+                            reference[mm][missing_rows] = reference_means[mm]
+                            reference[mm + '_valid'][missing_rows] = True
+                    for name in reference:
+                        np.testing.assert_array_equal(inputs[name], reference[name])
+                    reference_logits = ev.forward_numpy(model, reference, cancer, 'cpu')
+                    delta = float(np.max(np.abs(reference_logits - logits)))
+                    assert delta <= 1e-6
+                    max_parity = max(max_parity, delta)
+                    checked_inputs += len(ids)
+                for j, row in enumerate(audit):
+                    pid = ids[j]
+                    missing = [m for m in ('rna', 'text') if not raw[m + '_valid'][j]]
+                    assert row['query_valid_rows'] == test_counts[pid]
+                    assert row['padding_strategy'] == bank.metadata()['padding_strategy']
+                    for mm in ('rna', 'text'):
+                        assert row['natural_valid'][mm] == bool(natural[mm][j])
+                        assert row['original_valid'][mm] == bool(raw[mm + '_valid'][j])
+                        assert row['fusion_valid'][mm] == bool(raw[mm + '_valid'][j] or arm != 'm0real')
+                    if arm == 'retrieval' and missing:
+                        winner, candidates = independently_select(pid, raw['img'][j], missing)
+                        assert row['donor_id'] == winner['donor_id']
+                        assert abs(row['similarity'] - winner['score']) <= 1e-12
+                        assert row['common_valid_rows'] == winner['common_valid_rows']
+                        assert row['candidate_count'] == len(candidates)
+                        assert row['donor_valid_rows'] == train_counts[row['donor_id']]
+                        for mm in missing:
+                            np.testing.assert_array_equal(inputs[mm][j], train[mm][row['donor_id']].astype(inputs[mm].dtype))
+                        checked_retrievals += 1
+                    else:
+                        assert row['donor_id'] is None and row['similarity'] is None
+                        assert row['donor_valid_rows'] is None and row['common_valid_rows'] is None
+                        assert row['candidate_count'] == 0
+            assert len(set(diagnostics)) == 1
+            if complete.any():
+                delta = max(float(np.max(np.abs(actual_logits[arm][complete] - actual_logits['m0real'][complete])))
+                            for arm in ('m1', 'retrieval'))
+                assert delta <= 1e-6
+                assert abs(delta - diagnostics[0][1]) <= 1e-6
+            else:
+                assert diagnostics[0] == (0, None)
+            complete_counts[grid] = diagnostics[0][0]
+        loo = []
+        for pid, count in padded['train'].items():
+            for missing in (['rna'], ['text'], ['rna', 'text']):
+                winner, candidates = independently_select(pid, train['img'][pid], missing)
+                selected = bank.retrieve(pid, train['img'][pid], missing, query_split='train')
+                assert selected['donor_id'] == winner['donor_id'] != pid
+                assert abs(selected['similarity'] - winner['score']) <= 1e-12
+                assert selected['candidate_count'] == len(candidates)
+                loo.append({'query_id': pid, 'query_valid_rows': count, 'missing': missing,
+                            'donor_id': winner['donor_id'], 'candidate_count': len(candidates),
+                            'candidate_scores': candidates})
+        # 两位 padded train 作为合法候选参加 test 配对评分，不只查入库人数。
+        candidate_participation = {pid: sum(any(r['donor_id'] == pid for r in scores)
+                                           for _, scores in formula_cache.values())
+                                   for pid in padded['train']}
+        assert all(n > 0 for n in candidate_participation.values())
+        for (mm, pid), expected in hashes_before.items():
+            value = source.features[mm[5:]][pid] if mm.startswith('test_') else train[mm][pid]
+            assert array_sha(value) == expected
+        for name, expected in before_weights.items():
+            assert torch.equal(model.state_dict()[name], expected)
+        for name, expected in current['provenance']['cache_hashes'].items():
+            assert sha(args.data_root / 'tmp_sur_cache' / name) == expected
+        results[cancer] = {'status': 'PASS', 'test_ids': ids, 'padded': padded,
+                           'checkpoint_count': 5, 'complete_checked_per_grid': complete_counts,
+                           'reference_input_patient_grid_arms': checked_inputs,
+                           'm0real_m1_reference_max_logit_abs_diff': max_parity,
+                           'independent_retrieval_checks': checked_retrievals,
+                           'mu_change_from_padding_included_max_abs': float(np.max(np.abs(mu - old_mu))),
+                           'padded_train_candidate_participation': candidate_participation,
+                           'train_leave_one_out': loo, 'model_and_raw_features_unchanged': True}
+        print(f'PASS {cancer}: smoke={len(ids)}, reference_inputs={checked_inputs}, retrievals={checked_retrievals}', flush=True)
+        del bank, source, model, train, keys, formula_cache, hashes_before, before_weights
+        gc.collect()
+    result = {'status': 'PASS', 'protocol_id': 'patient-fixed-padmask-v2', 'cancers': results,
+              'formal_cindex_count': 0, 'script_sha256': sha(Path(__file__)),
+              'note': 'm0real/m1 对拍是原填补定义的独立参考；不宣称旧 v1 全流程允许补零。'}
+    with args.out.open('x') as handle:
+        json.dump(result, handle, indent=2, ensure_ascii=False, allow_nan=False)
+
+
+if __name__ == '__main__':
+    main()
