+"""留档一个明确命令及退出码；拒绝覆盖，不替代验收。"""
+import datetime
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+folder = Path(__file__).resolve().parent
+name, *command = sys.argv[1:]
+with (folder / f'{name}.log').open('x') as log:
+    process = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT)
+record = {'command': command, 'returncode': process.returncode,
+          'finished_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+          'log_sha256': hashlib.sha256((folder / f'{name}.log').read_bytes()).hexdigest()}
+with (folder / f'{name}.json').open('x') as handle:
+    json.dump(record, handle, indent=2)
+print(json.dumps(record))
+print((folder / f'{name}.log').read_text()[-5000:])
+raise SystemExit(process.returncode)
