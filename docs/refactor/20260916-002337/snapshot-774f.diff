+"""只读复核留档：25 个权重身份、smoke 哈希/预测/供体/mask；不运行模型。"""
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+EVIDENCE = HERE / 'evidence'
+CODE = HERE.parents[1] / 'code/NPJ'
+SEEDS = {'123', '132', '213', '231', '321'}
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def verify_smoke(name):
+    base = EVIDENCE / name
+    preflight = read(base / 'diagnostics/preflight.json')
+    assert not preflight['failures']
+    assert read(base / 'diagnostics/campaign_status.json') == {'stage': 'smoke', 'status': 'COMPLETED'}
+    summary = {}
+    for cancer, report in preflight['reports'].items():
+        bank = report['provenance']['bank']
+        count, maximum = 0, 0.0
+        for path in (base / 'smoke').glob(f'*_{cancer}_s123.json'):
+            unit = read(path)
+            assert unit['stage'] == 'smoke' and unit['device'] == 'cpu'
+            assert unit['checkpoint_sha256'] == report['checkpoints']['123']['sha256']
+            for grid, result in unit['grids'].items():
+                assert 'cindex_B' not in result
+                for role in ('predictions', 'audit'):
+                    assert digest(base / result[role + '_file']) == result[role + '_sha256']
+                prediction = np.load(base / result['predictions_file'], allow_pickle=False)
+                audit = read(base / result['audit_file'])
+                ids, logits = prediction['patient_id'].tolist(), prediction['logits']
+                assert ids == [row['patient_id'] for row in audit]
+                assert logits.shape == (result['n_test'], 4) and np.isfinite(logits).all()
+                hazards = np.clip(1 / (1 + np.exp(-logits)), 1e-6, 1 - 1e-6)
+                risk = -np.cumprod(1 - hazards, axis=1).sum(axis=1)
+                np.testing.assert_allclose(prediction['risk_B'], risk, atol=1e-6, rtol=0)
+                for row in audit:
+                    missing = [m for m in ('rna', 'text') if not row['original_valid'][m]]
+                    for mm in ('rna', 'text'):
+                        artificial = grid == 'both_100' or grid == mm + '_100'
+                        assert row['original_valid'][mm] == (row['natural_valid'][mm] and not artificial)
+                        assert row['fusion_valid'][mm] == (row['original_valid'][mm] or unit['arm'] != 'm0real')
+                    if unit['arm'] == 'retrieval' and missing:
+                        assert row['donor_id'] in bank['train_ids'] and row['donor_id'] != row['patient_id']
+                        expected = bank['both_available_count'] if len(missing) == 2 else bank['available_counts'][missing[0]]
+                        assert row['candidate_count'] == expected and np.isfinite(row['similarity'])
+                    else:
+                        assert row['donor_id'] is None and row['candidate_count'] == 0
+                maximum = max(maximum, result['complete_max_logit_abs_diff'])
+                count += 1
+        assert count == 12 and maximum <= 1e-6
+        summary[cancer] = {'grids_across_three_arms': count, 'complete_max_abs_diff': maximum}
+    return summary
+
+
+def main():
+    preflight = EVIDENCE / 'preflight-v3/diagnostics'
+    checkpoints = {}
+    for path in sorted(preflight.glob('checkpoints_*.json')):
+        content = read(path)
+        assert set(content) == SEEDS and all(row['strict_load'] for row in content.values())
+        assert len({row['state_sha256'] for row in content.values()}) == 5
+        checkpoints[path.stem] = len(content)
+    assert sum(checkpoints.values()) == 25
+    report = read(preflight / 'preflight.json')
+    assert set(report['failures']) == {'BLCA', 'LGG'}
+    for unit in report['reports'].values():
+        for relative, expected in unit['provenance']['source_hashes'].items():
+            assert digest(CODE / relative) == expected, relative
+    result = {'checkpoint_count': 25, 'blocked_cancers': report['failures'],
+              'smoke_v2': verify_smoke('smoke-v2'), 'smoke_v3': verify_smoke('smoke-v3'),
+              'formal_cindex_count': 0}
+    print(json.dumps(result, indent=2, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    main()
