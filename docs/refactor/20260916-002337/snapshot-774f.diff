+"""仅加已审核资产指纹门禁；不改变原评测计算、模型或缺失协议。"""
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+TASK = HERE.parent
+
+
+def sha(path):
+    digest = hashlib.sha256()
+    with path.open('rb') as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main():
+    baseline_path = HERE / 'approved-preflight.json'
+    baseline = json.loads(baseline_path.read_text())
+    source = TASK / 'src'
+    assets = TASK / 'assets'
+    sys.path.insert(0, str(source / 'scripts'))
+    import eval_patient_retrieval as ev
+    expected = {}
+    for report in baseline['reports'].values():
+        for item in report['checkpoints'].values():
+            relative = Path(item['path']).relative_to('/home/wuhao/NPJ')
+            expected[str((assets / relative).resolve())] = item
+        for name, digest in report['provenance']['cache_hashes'].items():
+            if sha(assets / 'tmp_sur_cache' / name) != digest:
+                raise ValueError('冻结缓存已变化: ' + name)
+        for name, field in [('TCGA_9523_ex12.csv', 'label_sha256'),
+                            ('missing_manifest_v1.csv', 'manifest_sha256')]:
+            if sha(assets / 'data' / name) != report['provenance'][field]:
+                raise ValueError('标签或缺失manifest已变化: ' + name)
+        for name, digest in report['provenance']['source_hashes'].items():
+            if sha(source / name) != digest:
+                raise ValueError('已审核源码已变化: ' + name)
+    if len(expected) != 25:
+        raise ValueError('批准的权重基准不是25份')
+    for path, item in expected.items():
+        if sha(Path(path)) != item['sha256']:
+            raise ValueError('权重与批准基准不一致: ' + path)
+
+    original_load = ev.strict_e0_load
+
+    def pinned_load(model, path, *, expected_file_sha=None):
+        item = expected[str(path.resolve())]
+        if expected_file_sha is not None and expected_file_sha != item['sha256']:
+            raise ValueError('运行时基准偏离已批准权重')
+        # 原加载器对同一内存字节算SHA并load，阻止核验后换文件。
+        state_sha = original_load(model, path, expected_file_sha=item['sha256'])
+        if state_sha != item['state_sha256']:
+            raise ValueError('运行时state指纹偏离已批准权重')
+        return state_sha
+
+    ev.strict_e0_load = pinned_load
+    print(json.dumps({'asset_gate': 'PASS', 'n_checkpoints': 25,
+                      'approved_preflight_sha256': sha(baseline_path),
+                      'guard_sha256': sha(Path(__file__))}), flush=True)
+    if sys.argv[1:] == ['--verify-only']:
+        return 0
+    return ev.main(sys.argv[1:])
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
