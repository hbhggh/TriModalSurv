+    || { FAIL=$((FAIL+1)); echo "SEED_${sd}_FAILED"; [ $FAIL -ge 2 ] && { echo "TWO_FAILS_STOP_${ARM}_${CU}"; exit 1; }; }
+done
+echo "C_UNIT_${ARM}_${CU}_DONE"
