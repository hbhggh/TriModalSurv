+def _pad_path_features(batch):
+    if not batch:
+        raise ValueError('batched collate requires at least one patient')
+
+    paths = [item[0] for item in batch]
+    if any(not torch.is_tensor(path) or path.dim() != 2 or path.size(0) == 0 for path in paths):
+        raise ValueError('each path feature bag must be a non-empty [L, D] tensor')
+    feature_dim = paths[0].size(1)
+    if any(path.size(1) != feature_dim for path in paths):
+        raise ValueError('all path feature bags must use the same feature dimension')
+
+    lengths = torch.tensor([path.size(0) for path in paths], dtype=torch.long)
+    max_length = int(lengths.max().item())
+    padded = paths[0].new_zeros((len(paths), max_length, feature_dim))
+    padding_mask = torch.ones((len(paths), max_length), dtype=torch.bool)
+    for index, path in enumerate(paths):
+        length = path.size(0)
+        padded[index, :length].copy_(path)
+        padding_mask[index, :length] = False
+    return padded, padding_mask
+
+def _stack_patient_vectors(values, dtype):
+    vectors = [torch.as_tensor(value).reshape(-1) for value in values]
+    return torch.stack(vectors, dim=0).to(dtype=dtype)
+
+def _stack_patient_scalars(values, dtype):
+    scalars = []
+    for value in values:
+        tensor = torch.as_tensor(value)
+        if tensor.numel() != 1:
+            raise ValueError('patient label/time/censorship must contain exactly one value')
+        scalars.append(tensor.reshape(()))
+    return torch.stack(scalars, dim=0).to(dtype=dtype)
