+def _step_sample_mean_gradients(model, optimizer, accumulated_samples):
+    if accumulated_samples <= 0:
+        raise ValueError('accumulated_samples must be positive before optimizer.step')
+    for parameter in model.parameters():
+        if parameter.grad is not None:
+            parameter.grad.div_(accumulated_samples)
+    optimizer.step()
+    optimizer.zero_grad()
+
