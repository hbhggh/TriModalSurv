# 第三层监视器开关与白名单（monitor_check.sh 读取）
# 当前模式：只报警，不自动重启（S4 全量训练启动时改为 whitelist 并通知 Claude 加审计逻辑）
AUTO_RESTART=off
# 白名单（AUTO_RESTART=whitelist 时才生效；模式匹配 job_id 前缀）
RESTART_WHITELIST="gdc_ pt_conv_ seed_"
# 禁止名单（任何模式下都不碰；硬编码双保险）
RESTART_FORBIDDEN="summary tmp_sur_cache done"
# stalled 判定阈值（秒）与连续报警轮数
STALL_SEC=1200
STALL_ALERT_ROUNDS=2
