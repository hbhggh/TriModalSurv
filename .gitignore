.DS_Store
__pycache__/
*.pyc
*.so

# 嵌套独立 git 克隆（不跟踪）；NPJ 工作树快照见 code/NPJ/（含对上游 patch），基线只留 collab/**/*_patch.diff
/NPJ/
/baselines/

# scratch 重资产（可再生 / 第三方 / 原始数据），按子路径而非整个 scratch/（scratch 内的测试脚本与 split 小表保留）
collab/**/scratch/*pycache*/
collab/**/scratch/pyc_verify/
collab/**/scratch/r2_outcome/adapted_csv/
collab/**/scratch/ex12_outcome/
collab/**/scratch/e_sksurv_vendor/
collab/**/scratch/gdc_test/*.tsv
collab/**/scratch/e_eval_frozen_synthetic/**/*.pt
collab/**/scratch/e_eval_frozen_synthetic/**/*.csv.zip

# 巡检运行态（非过程文本）
collab/monitor/.last_status.json
collab/monitor/.stall_counts
tmp_*/

# 重构后的实验大文件：仅清单与分析入 Git，原始资产保留在磁盘。
/experiments/**/results/**/checkpoints/
/experiments/**/results/**/raw/
/experiments/**/results/**/logs/
/experiments/**/results/**/*.npz

# 运行即盖章：账本与 stamp 都是派生物（账本可由 run 目录重建，stamp 由 HEAD 生成），跨分支唯一，不进 Git。
/results.tsv
/results.tsv.tmp
/GIT_STAMP.json
/GIT_STAMP.json.tmp

# LaTeX 编译产物：只跟踪 .tex 和最终 .pdf。
/manuscript/**/*.aux
/manuscript/**/*.log
/manuscript/**/*.out
/manuscript/**/*.synctex.gz

# 全项目重构：原始归档/仓库元数据/本轮传输包保留磁盘，不进源码提交。
/archive/
/docs/refactor/**/*.tar
/docs/refactor/**/*.index
/docs/refactor/**/*.bin
/docs/refactor/**/validation-evidence/**/*.pt
